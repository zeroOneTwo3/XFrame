<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:XFrame.PageModels"             
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="XFrame.Pages.MainPage"
             x:DataType="pageModels:MainPageModel"
             Title="XML Transformer Pro">

    <Grid RowDefinitions="Auto, *" ColumnDefinitions="*, *" Padding="10" ColumnSpacing="10" RowSpacing="10">

        <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="2" Spacing="10">
            <Button Text="Select XML" 
            Command="{Binding SelectXmlCommand}" />
            <Button Text="Select XSLT" 
            Command="{Binding SelectXsltCommand}" />
            <Button Text="Transform" 
            Command="{Binding TransformCommand}" 
            BackgroundColor="{StaticResource Primary}"
            TextColor="White" />
            <Button Text="Export Result" 
            Command="{Binding ExportCommand}" 
            IsEnabled="{Binding HasResult}" />
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="5">
            <Label Text="Source Editor" Style="{StaticResource Title3}" />

            <Border StrokeShape="RoundRectangle 5" StrokeThickness="1">
                <Editor Text="{Binding RawXmlContent, Mode=TwoWay}" 
                        Placeholder="Select or paste XML here..."
                        HeightRequest="300" 
                        FontFamily="Consolas" 
                        AutoSize="Disabled" />
            </Border>

            <Label Text="XSLT Content" Style="{StaticResource Title3}" Margin="0,10,0,0" />
            <Border StrokeShape="RoundRectangle 5" StrokeThickness="1">
                <Editor Text="{Binding XsltContent, Mode=TwoWay}" 
                        Placeholder="Select or paste XSLT here..."
                        HeightRequest="200" 
                        FontFamily="Consolas" />
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto, *">
            <Label Grid.Row="0" Text="Transformation Result" Style="{StaticResource Title3}" />

            <Border Grid.Row="1" StrokeShape="RoundRectangle 5" BackgroundColor="#F5F5F5">
                <Editor Text="{Binding TransformedResult}" 
                        IsReadOnly="True" 
                        FontFamily="Consolas" 
                        TextColor="DarkBlue" />
            </Border>
        </Grid>

        <ActivityIndicator Grid.Row="1" Grid.ColumnSpan="2" 
                           IsRunning="{Binding IsBusy}" 
                           VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>